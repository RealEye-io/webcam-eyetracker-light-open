{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "paths": {
            "@lib/*": [
                "./lib/*"
            ],
            "@demo/*": [
                "./apps/demo_app/*"
            ]
        },
        "types": [
            "node"
        ]
    },
    "include": [
        "lib/**/*",
        "apps/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "tests"
    ]
}